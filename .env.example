# =============================================================================
# Alternup — fichier d'exemple. Copier en `.env` et compléter.
#  - En dev local : remplir tous les champs marqués (required).
#  - Sur Dokploy : renseigner les mêmes clefs dans l'UI Dokploy.
# =============================================================================

# --- Application (required) ---------------------------------------------------

# URL Postgres lue par Prisma. Doit pointer vers le service `postgres`
# du compose en production, ou un Postgres local en dev.
DATABASE_URL=postgresql://alternup:change-me@localhost:5432/alternup

# Secret pour signer les cookies de session (nuxt-auth-utils).
# Doit faire au moins 32 caractères. Générer avec `openssl rand -base64 48`.
NUXT_SESSION_PASSWORD=change-me-with-a-32-chars-or-more-random-string

# Jeton Bearer de l'API Apprentissage (La Bonne Alternance), requis par
# l'ingestion des offres (`scripts/ingest-offres.ts`). Se créer un compte et
# une clé sur https://api.apprentissage.beta.gouv.fr ; utiliser une clé de
# production en déploiement (la sandbox ne sert qu'aux tests locaux).
LBA_API_KEY=change-me-lba-api-key

# --- Postgres (compose-only, requis si on utilise le service postgres) -------

# Identifiants du conteneur Postgres lancé par docker-compose. Utilisés à la
# fois pour POSTGRES_* (init de la DB) et pour construire DATABASE_URL.
POSTGRES_USER=alternup
POSTGRES_PASSWORD=change-me-strong-postgres-password
POSTGRES_DB=alternup

# --- Optionnel ---------------------------------------------------------------

# Port exposé sur l'hôte (compose). Le conteneur écoute toujours sur 3000.
APP_PORT=3000

# Version affichée par /api/health. Renseigner depuis la CI ou Dokploy.
APP_VERSION=1.0.0

# `production` en déploiement, `development` en local.
NODE_ENV=development

# Webhook d'alerte de l'ingestion des offres : si renseignée, le script POSTe un
# JSON minimal (sujet, sources en échec, messages, date) quand au moins une
# source échoue. Absente = aucune alerte (le code de sortie 1 suffit en local).
# ALERTE_WEBHOOK_URL=

# Remplace l'appel `GET /job/v1/export` de LBA par une URL http(s) ou un fichier
# local (tests, secours si l'endpoint est indisponible). Ex. :
# LBA_EXPORT_URL_OVERRIDE=tests/fixtures/lba-export-sample.json

# Cookie de session réservé à HTTPS par défaut. Poser `false` UNIQUEMENT si l'app
# est exposée en HTTP simple (test derrière une IP, pas de certificat) : sinon le
# navigateur jette le cookie et la connexion semble « ne rien faire ».
# NUXT_SESSION_COOKIE_SECURE=false

# --- Compte de test (staging uniquement) --------------------------------------

# Si TEMP_LOGIN et TEMP_PASS sont renseignés, `server/plugins/temp-account.ts` crée
# — ou réaligne — ce compte à chaque démarrage. TEMP_LOGIN doit être une adresse
# e-mail ; TEMP_ROLE vaut Tutor | Alternant | Stagiaire (Tutor par défaut).
# Laisser vide en production.
# TEMP_LOGIN=
# TEMP_PASS=
# TEMP_ROLE=Tutor
