    "@vueuse/nuxt": "*",
    "bcrypt": "^6.0.0",
    "h3": "*",
    "jsonwebtoken": "*",
    "nuxt": "*",
    "nuxt-auth-utils": "^0.5.29",
    "pinia": "*",
    "prisma": "^7.8.0",
    "vue": "*",
    "vue-router": "*",
    "zod": "*"
  },
  "devDependencies": {
    "@nuxt/devtools": "*",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "*",
    "@types/node": "*",
    "@typescript-eslint/eslint-plugin": "*",
    "@typescript-eslint/parser": "*",
    "autoprefixer": "*",
    "dotenv": "^17.4.2",
    "eslint": "*",
    "eslint-plugin-vue": "*",
    "husky": "*",
    "lint-staged": "*",
    "postcss": "*",
    "tailwindcss": "*",
