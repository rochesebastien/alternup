// Prisma schema — Alternup
// Voir taches/a-faire.md pour le contexte de la migration depuis Supabase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  Tutor
  Alternant
  Stagiaire
}

enum ProjectStatus {
  non_demarre
  en_cours
  termine
  annule
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  role         Role     @default(Alternant)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations: réseau tuteur ↔ étudiants
  tutoredStudents TutorStudent[] @relation("Tutor")
  tutors          TutorStudent[] @relation("Student")
  invitationsSent Invitation[]   @relation("InvitationSender")

  // Relations: contenus créés
  coursesCreated  Course[]  @relation("CourseCreator")
  projectsCreated Project[] @relation("ProjectCreator")

  // Relations: assignments en tant qu'étudiant
  courseAssignments  CourseAssignment[]
  projectAssignments ProjectAssignment[]

  // Relations: calendrier
  studentEvents CalendarEvent[] @relation("EventStudent")
  tutorEvents   CalendarEvent[] @relation("EventTutor")

  // Relations: retours sur missions
  projectUpdates ProjectUpdate[]

  // Relations: modules PRONOTE (présences, rapports, annonces)
  attendancesRecorded    Attendance[]            @relation("AttendanceRecorder")
  presenceEntries        PresenceEntry[]         @relation("PresenceStudent")
  presenceEntriesRecorded PresenceEntry[]        @relation("PresenceRecorder")
  presenceRevisions       PresenceEntryRevision[] @relation("PresenceRevisionAuthor")
  reportsAsStudent       ProgressReport[]        @relation("ReportStudent")
  reportsAsTutor         ProgressReport[]        @relation("ReportTutor")
  announcementsAuthored  Announcement[]          @relation("AnnouncementAuthor")
  announcementsReceived  AnnouncementRecipient[] @relation("AnnouncementRecipient")

  // Relations: modules PRONOTE lot 2 (bulletins, visites)
  reportPeriods    ReportPeriod[] @relation("PeriodTutor")
  reportCards      ReportCard[]   @relation("CardStudent")
  visitsAsTutor    TutorVisit[]   @relation("VisitTutor")
  visitsAsStudent  TutorVisit[]   @relation("VisitStudent")

  // Relations: modules PRONOTE lot 3 (compétences, messagerie)
  competencyDomains     CompetencyDomain[]     @relation("DomainTutor")
  competencyAssessments CompetencyAssessment[] @relation("AssessmentStudent")
  assessmentsGiven      CompetencyAssessment[] @relation("AssessmentAssessor")
  conversationsAsTutor   Conversation[] @relation("ConvTutor")
  conversationsAsStudent Conversation[] @relation("ConvStudent")
  messagesAuthored       Message[]      @relation("MessageAuthor")

  // Relations: centre de notifications
  notifications Notification[] @relation("UserNotifications")

  // Relations: signatures de documents (bulletins, rapports)
  documentSignatures DocumentSignature[] @relation("UserSignatures")

  // Relations: veille d'offres (statuts de candidature de l'apprenant)
  offreStatuts OffreUserStatut[] @relation("UserOffreStatuts")

  @@index([role])
  @@map("users")
}

model TutorStudent {
  tutorId   String   @map("tutor_id") @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  addedAt   DateTime @default(now()) @map("added_at") @db.Timestamptz

  tutor   User @relation("Tutor", fields: [tutorId], references: [id], onDelete: Cascade)
  student User @relation("Student", fields: [studentId], references: [id], onDelete: Cascade)

  @@id([tutorId, studentId])
  @@map("tutor_students")
}

// Invitation d'onboarding : un tuteur invite un alternant/stagiaire par email.
// Le lien (token) mène sur /register pré-rempli ; à l'inscription le compte est
// créé avec le rôle invité et rattaché automatiquement au réseau du tuteur.
model Invitation {
  id         String    @id @default(uuid()) @db.Uuid
  tutorId    String    @map("tutor_id") @db.Uuid
  email      String
  firstName  String?   @map("first_name")
  lastName   String?   @map("last_name")
  role       Role      @default(Stagiaire)
  token      String    @unique
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tutor User @relation("InvitationSender", fields: [tutorId], references: [id], onDelete: Cascade)

  // Une seule invitation active par (tuteur, email) : ré-inviter la remplace.
  @@unique([tutorId, email])
  @@map("invitations")
}

model Course {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String?
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  createdBy   User?              @relation("CourseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignments CourseAssignment[]

  @@map("courses")
}

model CourseAssignment {
  id        String    @id @default(uuid()) @db.Uuid
  studentId String    @map("student_id") @db.Uuid
  courseId  String    @map("course_id") @db.Uuid
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  notes   CourseNote[]
  events  CalendarEvent[]

  @@unique([studentId, courseId, startDate])
  @@index([studentId])
  @@map("course_assignments")
}

model CourseNote {
  id              String   @id @default(uuid()) @db.Uuid
  assignmentId    String   @map("assignment_id") @db.Uuid
  sessionDate     DateTime @map("session_date") @db.Date
  grade           Decimal? @db.Decimal(5, 2)
  comment         String?
  notionsCovered  Json?    @map("notions_covered")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  assignment CourseAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@map("course_notes")
}

model Project {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String?
  internal    Boolean  @default(true)
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  createdBy   User?               @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignments ProjectAssignment[]

  @@map("projects")
}

model ProjectAssignment {
  id              String        @id @default(uuid()) @db.Uuid
  projectId       String        @map("project_id") @db.Uuid
  studentId       String        @map("student_id") @db.Uuid
  status          ProjectStatus @default(non_demarre)
  tutorComment    String?       @map("tutor_comment")
  studentComment  String?       @map("student_comment")
  startedAt       DateTime?     @map("started_at") @db.Timestamptz
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  updates ProjectUpdate[]

  @@unique([projectId, studentId])
  @@index([studentId])
  @@map("project_assignments")
}

// Journal append-only des retours de l'alternant/stagiaire (et du tuteur) sur une mission.
model ProjectUpdate {
  id           String         @id @default(uuid()) @db.Uuid
  assignmentId String         @map("assignment_id") @db.Uuid
  authorId     String         @map("author_id") @db.Uuid
  body         String
  status       ProjectStatus? // snapshot du statut au moment du retour (optionnel)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz

  assignment ProjectAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  author     User              @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([assignmentId, createdAt])
  @@map("project_updates")
}

model CalendarEvent {
  id                 String   @id @default(uuid()) @db.Uuid
  // Optionnel : un tuteur peut créer un événement sans alternant/stagiaire.
  studentId          String?  @map("student_id") @db.Uuid
  tutorId            String   @map("tutor_id") @db.Uuid
  courseAssignmentId String?  @map("course_assignment_id") @db.Uuid
  title              String
  startTime          DateTime @map("start_time") @db.Timestamptz
  endTime            DateTime @map("end_time") @db.Timestamptz
  // Présence de l'alternant exigée (n'a de sens que si `studentId` est renseigné).
  presenceRequired   Boolean  @default(false) @map("presence_required")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  student          User?             @relation("EventStudent", fields: [studentId], references: [id], onDelete: Cascade)
  tutor            User              @relation("EventTutor", fields: [tutorId], references: [id], onDelete: Cascade)
  courseAssignment CourseAssignment? @relation(fields: [courseAssignmentId], references: [id], onDelete: SetNull)
  attendance       Attendance?

  @@index([studentId, startTime])
  @@index([courseAssignmentId])
  @@map("calendar_events")
}

// ─────────────────────── Modules PRONOTE ───────────────────────

enum AttendanceStatus {
  present
  absent
  retard
  excuse
}

enum ReportStatus {
  brouillon
  soumis
  valide
  a_revoir
}

// A. Présences — un pointage par session (CalendarEvent), saisi par le tuteur.
model Attendance {
  id            String           @id @default(uuid()) @db.Uuid
  eventId       String           @unique @map("event_id") @db.Uuid
  status        AttendanceStatus
  minutesLate   Int?             @map("minutes_late")
  justification String?
  recordedById  String           @map("recorded_by") @db.Uuid
  recordedAt    DateTime         @default(now()) @map("recorded_at") @db.Timestamptz

  event      CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  recordedBy User          @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: Cascade)

  @@map("attendances")
}

enum PresenceKind {
  entreprise_sur_site
  entreprise_teletravail
  entreprise_conges
  ecole_formation
}

enum PresenceRevisionAction {
  created
  updated
}

// A bis. Pointage journalier — déclaré par l'alternant/stagiaire lui-même (ou
// par son tuteur) : « je suis là aujourd'hui, arrivé à 9h00, reparti à 17h30 ».
// Indépendant des sessions du calendrier (`Attendance`), qui restent pointées
// par le tuteur session par session.
//
// Les horaires sont stockés en minutes depuis minuit (heure locale déclarée) et
// non en `Timestamptz` : une heure d'arrivée est une heure de pendule, elle ne
// doit pas se décaler selon le fuseau du serveur ou du navigateur qui l'affiche.
model PresenceEntry {
  id           String       @id @default(uuid()) @db.Uuid
  studentId    String       @map("student_id") @db.Uuid
  date         DateTime     @db.Date
  startMinute  Int          @map("start_minute")
  endMinute    Int          @map("end_minute")
  kind         PresenceKind @default(entreprise_sur_site)
  recordedById String       @map("recorded_by") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  student    User                    @relation("PresenceStudent", fields: [studentId], references: [id], onDelete: Cascade)
  recordedBy User                    @relation("PresenceRecorder", fields: [recordedById], references: [id], onDelete: Cascade)
  revisions  PresenceEntryRevision[]

  // Un seul pointage par personne et par jour : re-pointer met à jour la ligne.
  @@unique([studentId, date])
  @@map("presence_entries")
}

// Journal append-only des écritures sur un pointage (création + modifications).
// Existe pour la lutte anti-triche : un apprenant ne peut plus retoucher son
// propre pointage une fois enregistré, mais son tuteur le peut — ce journal
// permet de repérer après coup une correction et de savoir qui l'a faite.
model PresenceEntryRevision {
  id           String                  @id @default(uuid()) @db.Uuid
  entryId      String                  @map("entry_id") @db.Uuid
  action       PresenceRevisionAction
  startMinute  Int                     @map("start_minute")
  endMinute    Int                     @map("end_minute")
  kind         PresenceKind
  changedById  String                  @map("changed_by") @db.Uuid
  changedAt    DateTime                @default(now()) @map("changed_at") @db.Timestamptz

  entry     PresenceEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  changedBy User          @relation("PresenceRevisionAuthor", fields: [changedById], references: [id], onDelete: Cascade)

  @@index([entryId, changedAt])
  @@map("presence_entry_revisions")
}

// B. Rapports d'étape — livret d'apprentissage. Machine à états côté serveur.
model ProgressReport {
  id            String       @id @default(uuid()) @db.Uuid
  studentId     String       @map("student_id") @db.Uuid
  tutorId       String       @map("tutor_id") @db.Uuid
  periodStart   DateTime     @map("period_start") @db.Date
  periodEnd     DateTime     @map("period_end") @db.Date
  title         String
  body          String
  difficulties  String?
  learnings     String?
  status        ReportStatus @default(brouillon)
  tutorFeedback String?      @map("tutor_feedback")
  submittedAt   DateTime?    @map("submitted_at") @db.Timestamptz
  reviewedAt    DateTime?    @map("reviewed_at") @db.Timestamptz
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  student User @relation("ReportStudent", fields: [studentId], references: [id], onDelete: Cascade)
  tutor   User @relation("ReportTutor", fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([studentId, periodEnd])
  @@index([tutorId, status])
  @@map("progress_reports")
}

// C. Annonces — canal descendant tuteur -> ses étudiants, avec accusé de lecture.
model Announcement {
  id        String   @id @default(uuid()) @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  title     String
  body      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  author     User                    @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  recipients AnnouncementRecipient[]

  @@index([authorId, createdAt])
  @@map("announcements")
}

model AnnouncementRecipient {
  announcementId String    @map("announcement_id") @db.Uuid
  studentId      String    @map("student_id") @db.Uuid
  readAt         DateTime? @map("read_at") @db.Timestamptz

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  student      User         @relation("AnnouncementRecipient", fields: [studentId], references: [id], onDelete: Cascade)

  @@id([announcementId, studentId])
  @@index([studentId])
  @@map("announcement_recipients")
}

// ─────────────────────── Modules PRONOTE — Lot 2 ───────────────────────

enum VisitStatus {
  planifiee
  realisee
  annulee
}

// D. Bulletins périodiques — une période de bulletin définie par le tuteur.
model ReportPeriod {
  id        String    @id @default(uuid()) @db.Uuid
  tutorId   String    @map("tutor_id") @db.Uuid
  label     String
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime  @map("end_date") @db.Date
  closedAt  DateTime? @map("closed_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tutor User         @relation("PeriodTutor", fields: [tutorId], references: [id], onDelete: Cascade)
  cards ReportCard[]

  @@index([tutorId])
  @@map("report_periods")
}

// Bulletin d'un étudiant pour une période. `snapshot` fige les moyennes + assiduité à la publication.
model ReportCard {
  id             String    @id @default(uuid()) @db.Uuid
  periodId       String    @map("period_id") @db.Uuid
  studentId      String    @map("student_id") @db.Uuid
  generalComment String?   @map("general_comment")
  snapshot       Json?
  publishedAt    DateTime? @map("published_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  period  ReportPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  student User         @relation("CardStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([periodId, studentId])
  @@index([studentId])
  @@map("report_cards")
}

// G. Visites tuteur — visite planifiée (entreprise/école/visio) avec compte-rendu.
model TutorVisit {
  id          String      @id @default(uuid()) @db.Uuid
  studentId   String      @map("student_id") @db.Uuid
  tutorId     String      @map("tutor_id") @db.Uuid
  scheduledAt DateTime    @map("scheduled_at") @db.Timestamptz
  mode        String?
  location    String?
  status      VisitStatus @default(planifiee)
  summary     String?
  nextSteps   String?     @map("next_steps")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  student User @relation("VisitStudent", fields: [studentId], references: [id], onDelete: Cascade)
  tutor   User @relation("VisitTutor", fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId, scheduledAt])
  @@index([studentId])
  @@map("tutor_visits")
}

// ─────────────────────── Modules PRONOTE — Lot 3 ───────────────────────

enum CompetencyLevel {
  decouverte
  en_cours
  acquis
  maitrise
}

// E. Référentiel de compétences — domaines et compétences définis par le tuteur.
model CompetencyDomain {
  id        String   @id @default(uuid()) @db.Uuid
  tutorId   String   @map("tutor_id") @db.Uuid
  label     String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tutor        User         @relation("DomainTutor", fields: [tutorId], references: [id], onDelete: Cascade)
  competencies Competency[]

  @@index([tutorId])
  @@map("competency_domains")
}

model Competency {
  id        String   @id @default(uuid()) @db.Uuid
  domainId  String   @map("domain_id") @db.Uuid
  label     String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  domain      CompetencyDomain       @relation(fields: [domainId], references: [id], onDelete: Cascade)
  assessments CompetencyAssessment[]

  @@index([domainId])
  @@map("competencies")
}

// Évaluation d'une compétence pour un étudiant (append-only : le plus récent fait foi).
model CompetencyAssessment {
  id           String          @id @default(uuid()) @db.Uuid
  competencyId String          @map("competency_id") @db.Uuid
  studentId    String          @map("student_id") @db.Uuid
  level        CompetencyLevel
  comment      String?
  assessedById String          @map("assessed_by") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz

  competency Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  student    User       @relation("AssessmentStudent", fields: [studentId], references: [id], onDelete: Cascade)
  assessedBy User       @relation("AssessmentAssessor", fields: [assessedById], references: [id], onDelete: Cascade)

  @@index([studentId, competencyId, createdAt])
  @@map("competency_assessments")
}

// F. Messagerie — un fil unique par couple tuteur/étudiant.
model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  tutorId   String   @map("tutor_id") @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tutor    User      @relation("ConvTutor", fields: [tutorId], references: [id], onDelete: Cascade)
  student  User      @relation("ConvStudent", fields: [studentId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([tutorId, studentId])
  @@map("conversations")
}

model Message {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  authorId       String    @map("author_id") @db.Uuid
  body           String
  readAt         DateTime? @map("read_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User         @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ─────────────────────── Centre de notifications ───────────────────────

// H. Notifications — un événement adressé à un utilisateur (annonce publiée,
// rapport soumis/relu, bulletin publié, visite planifiée, message reçu).
// `type` reste une String libre : les valeurs sont typées côté application
// (`shared/utils/notifications.ts`), ce qui évite une migration d'enum à chaque
// nouvel événement. Les RELANCES d'échéances ne sont pas stockées ici : elles
// sont recalculées à la volée à chaque lecture.
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime? @map("read_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ─────────────────────── Signature tripartite ───────────────────────

/** Nature du document signé. Chaque valeur pointe vers une table distincte. */
enum SignatureDocumentType {
  bulletin // -> ReportCard
  rapport // -> ProgressReport
}

// I. Signatures horodatées — exigence OPCO/financeurs. Une ligne = une partie
// (tuteur OU étudiant) ayant signé un document. La relation vers le document
// est POLYMORPHE (`documentType` + `documentId`) : pas de FK, la cohérence est
// garantie côté application par `server/utils/signatures.ts`, qui recharge le
// document via ses helpers de visibilité avant toute écriture. Le couple
// (type, document, signataire) est unique : signer est idempotent, et une
// signature n'est jamais rétractable (append-only, `signedAt` fait foi).
model DocumentSignature {
  id           String                @id @default(uuid()) @db.Uuid
  documentType SignatureDocumentType @map("document_type")
  documentId   String                @map("document_id") @db.Uuid
  userId       String                @map("user_id") @db.Uuid
  signedAt     DateTime              @default(now()) @map("signed_at") @db.Timestamptz

  user User @relation("UserSignatures", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([documentType, documentId, userId])
  @@index([documentType, documentId])
  @@map("document_signatures")
}

// ─────────────────────── Veille d'offres ───────────────────────
// Modèle de données défini par docs/adr/0002-modele-donnees-veille.md.

enum OffreSourceType {
  la_bonne_alternance
  // futur : france_travail, firecrawl — ajout par simple migration d'enum
}

enum OffreContratType {
  apprentissage
  professionnalisation
  // v1 = alternance seule ; les stages sont explicitement hors périmètre (gate phase 0)
}

enum OffreStatut {
  active
  expiree
}

/** Statut de suivi d'une offre par un apprenant (jamais supprimé, upsert). */
enum CandidatureStatut {
  vue
  candidate
  rejetee
}

enum ScrapeRunStatut {
  en_cours
  succes
  erreur
}

// J. Offre dédupliquée. Les champs non promus en colonnes (salaire, compétences,
// geopoint…) restent dans `raw` (règle « pas de sur-modélisation », ADR-0002).
// Jamais de suppression physique : une offre disparue passe `statut: expiree`
// (soft-delete) pour préserver l'historique de candidature des apprenants.
model Offre {
  id            String          @id @default(uuid()) @db.Uuid
  // apply.url LBA : lien de candidature/origine, clé de dédup primaire
  url           String          @unique
  // sha256 de (titre + entreprise + lieu) normalisés (minuscules, accents/espaces réduits)
  dedupHash     String          @unique @map("dedup_hash")
  // première source ayant vu l'offre (les rattachements ultérieurs vivent dans OffreSource)
  sourceOrigine OffreSourceType @map("source_origine")

  // Champs normalisés extraits du payload (mapping export LBA entre parenthèses)
  titre           String // offer.title
  entreprise      String? // workplace.name ?? workplace.legal_name
  lieu            String? // workplace.location.address
  // Ville et code postal extraits de `lieu` par `parseLieu` (shared/utils/offres.ts),
  // pour le filtre ville de la page offres (ADR-0004) — jamais renseignés par la source.
  ville           String?
  codePostal      String?           @map("code_postal")
  typeContrat     OffreContratType? @map("type_contrat") // contract.type[0]
  niveauDiplome   String?           @map("niveau_diplome") // offer.target_diploma.level
  romeCodes       String[]          @map("rome_codes") // offer.rome_codes
  datePublication DateTime?         @map("date_publication") @db.Timestamptz // offer.publication.creation
  dateExpiration  DateTime?         @map("date_expiration") @db.Timestamptz // offer.publication.expiration

  // Payload source complet, non retraité (audit, réextraction future sans re-fetch)
  raw Json

  statut    OffreStatut @default(active)
  firstSeen DateTime    @default(now()) @map("first_seen") @db.Timestamptz
  lastSeen  DateTime    @default(now()) @map("last_seen") @db.Timestamptz

  sources     OffreSource[]
  userStatuts OffreUserStatut[]

  @@index([statut, datePublication])
  @@index([typeContrat])
  @@index([firstSeen])
  @@index([codePostal])
  @@map("offres")
}

// Rattachement n-n offre ↔ canal d'ingestion : une même offre peut être vue
// par plusieurs sources (demain : LBA et FT direct). Une ligne par couple
// (offre, source), portant l'identité de l'offre chez le partenaire d'origine.
model OffreSource {
  offreId      String          @map("offre_id") @db.Uuid
  source       OffreSourceType
  // Attribution LBA : identifier.partner_label (ex. « France Travail », « Hellowork »)
  partnerLabel String?         @map("partner_label")
  // identifier.partner_job_id (pour une offre FT relayée par LBA : l'id France Travail)
  partnerJobId String?         @map("partner_job_id")
  firstSeen    DateTime        @default(now()) @map("first_seen") @db.Timestamptz
  lastSeen     DateTime        @default(now()) @map("last_seen") @db.Timestamptz

  offre Offre @relation(fields: [offreId], references: [id], onDelete: Cascade)

  // L'index (source, partnerLabel, partnerJobId) sert la dédup croisée le jour
  // où une ingestion FT directe est ajoutée (clé robuste, rapport D).
  @@id([offreId, source])
  @@index([source, partnerLabel, partnerJobId])
  @@map("offre_sources")
}

// Suivi d'une offre par un apprenant. PK composite sur le modèle de
// TutorStudent / AnnouncementRecipient ; reposer un statut = upsert.
model OffreUserStatut {
  userId    String            @map("user_id") @db.Uuid
  offreId   String            @map("offre_id") @db.Uuid
  statut    CandidatureStatut
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  user  User  @relation("UserOffreStatuts", fields: [userId], references: [id], onDelete: Cascade)
  offre Offre @relation(fields: [offreId], references: [id], onDelete: Cascade)

  @@id([userId, offreId])
  @@index([userId, statut])
  @@map("offre_user_statuts")
}

// Journal d'exécution de l'ingestion (une ligne par run et par source).
// La durée se dérive de `finishedAt - startedAt` (pas de colonne redondante).
model ScrapeRun {
  id             String          @id @default(uuid()) @db.Uuid
  source         OffreSourceType
  statut         ScrapeRunStatut @default(en_cours)
  startedAt      DateTime        @default(now()) @map("started_at") @db.Timestamptz
  finishedAt     DateTime?       @map("finished_at") @db.Timestamptz
  pagesVues      Int             @default(0) @map("pages_vues") // pages/fichiers traités
  offresVues     Int             @default(0) @map("offres_vues")
  offresCreees   Int             @default(0) @map("offres_creees")
  offresMaj      Int             @default(0) @map("offres_maj")
  offresExpirees Int             @default(0) @map("offres_expirees")
  creditsEstimes Int             @default(0) @map("credits_estimes") // 0 pour LBA ; Firecrawl plus tard
  erreurs        Json? // liste { message, contexte } sérialisée par le script

  @@index([source, startedAt])
  @@map("scrape_runs")
}
